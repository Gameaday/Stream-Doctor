<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="StreamDoctor.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:StreamDoctor.App.ViewModels"
    Title="Stream Doctor">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Stream Doctor" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="The pre-flight and post-flight mechanic for your streaming PC." Opacity="0.7" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <Button
                Content="Run pre-flight sweep"
                Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.RunPreFlightCommand}" />
            <Button Content="Post-flight debrief" Command="{x:Bind ViewModel.RunPostFlightCommand}" />
            <ProgressRing Width="22" Height="22" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </StackPanel>

        <Border Grid.Row="2" Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="48" FontWeight="SemiBold"
                           Text="{x:Bind ViewModel.HealthScoreText, Mode=OneWay}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="Health score" Opacity="0.6" />
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"
                               Text="{x:Bind ViewModel.HealthHeadline, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <ItemsControl Grid.Row="3" ItemsSource="{x:Bind ViewModel.Modules, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ModuleCardViewModel">
                    <Border Width="230" Margin="0,0,12,12" Padding="14" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="12" Height="12" Fill="{x:Bind StateBrush}" />
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind StatusText}" Opacity="0.75" />
                            <TextBlock Text="{x:Bind Detail}" Opacity="0.55"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ListView Grid.Row="4" SelectionMode="None" ItemsSource="{x:Bind ViewModel.Findings, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:FindingViewModel">
                    <Border Margin="0,0,0,10" Padding="16" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Padding="6,2" CornerRadius="4" Background="{x:Bind SeverityBrush}">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="{x:Bind SeverityText}" />
                                </Border>
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"
                                           Text="{x:Bind ModuleName}" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"
                                           Text="{x:Bind ConfidenceText}" />
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{x:Bind Title}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.8" Text="{x:Bind Explanation}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.7" FontStyle="Italic" Text="{x:Bind ActionText}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.5"
                                       Text="{x:Bind EvidenceText}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="5" TextWrapping="Wrap" Opacity="0.7"
                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
    </Grid>
</Window>
