<Project>

  <!--
    Central package management. Every package below is either a BCL/Windows-SDK
    package maintained by Microsoft or a single large community project, per the
    dependency policy in the product design document (§5).
    Versions are pinned; packages.lock.json files are committed by each project.
  -->
  <ItemGroup Label="Interop and Windows collectors">
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.367" />
    <PackageVersion Include="System.Management" Version="10.0.13" />
    <PackageVersion Include="System.Diagnostics.EventLog" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Storage and application">
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>

</Project>
